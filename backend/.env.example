# Backend Server Environment Variables (NEVER expose to frontend)
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/jnanayogayu

# Authentication / JWT
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
OTP_EXPIRY_MINUTES=10

# Razorpay Payment Gateway & Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business API & Email
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Private Object Storage (S3 / Cloudflare R2)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

